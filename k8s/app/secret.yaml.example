# Copy to secret.yaml (gitignored) and fill in real values.
# DO NOT commit secret.yaml.
# Values must match terraform.tfvars db_password.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: smallbiz
type: Opaque
stringData:
  DB_USERNAME: "dbadmin"
  DB_PASSWORD: "CHANGE_ME"  # set to match terraform.tfvars db_password
